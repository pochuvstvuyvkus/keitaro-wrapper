# Keitaro Admin API. Key: admin -> Profile -> API keys.
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=
# Cloudflare in front of the tracker rejects non-browser user agents (403); the default is a Chrome UA.
# KEITARO_USER_AGENT=

# What new campaigns get: group FORTESTS, traffic source FORTESTS, domain in.posdk.xyz
KEITARO_GROUP_ID=4970
KEITARO_TRAFFIC_SOURCE_ID=473
KEITARO_DOMAIN_ID=4622
GEO_REDIRECT_URL=https://google.com

# SQLAlchemy URL; any database SQLAlchemy supports, e.g. postgresql+psycopg://user:pass@localhost/adrobot
DATABASE_URL=sqlite:///./adrobot.db
# How long the offers list is cached for the autocomplete, seconds
OFFERS_CACHE_TTL=300
